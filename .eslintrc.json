{
  "extends": ["@salesforce/eslint-config-lwc/recommended"],
  "overrides": [
    {
      "files": ["**/lwc/**/*.js"],
      "rules": { "@lwc/lwc/no-async-operation": "off" }
    },
    {
      "files": ["**/lwc/**/__tests__/**/*.js"],
      "env": { "jest": true, "node": true },
      "rules": { "@lwc/lwc/no-unexpected-wire-adapter-usages": "off" }
    }
  ]
}
