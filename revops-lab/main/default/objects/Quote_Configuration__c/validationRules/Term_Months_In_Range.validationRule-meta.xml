<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Term_Months_In_Range</fullName>
    <active>true</active>
    <description>Term must be between 1 and 60 months.</description>
    <errorConditionFormula>OR(ISBLANK(Term_Months__c), Term_Months__c &lt; 1, Term_Months__c &gt; 60)</errorConditionFormula>
    <errorDisplayField>Term_Months__c</errorDisplayField>
    <errorMessage>Term must be between 1 and 60 months.</errorMessage>
</ValidationRule>
