<?xml version="1.0" encoding="UTF-8"?>
<!--
  DESIGN / CONFIGURATION SPECIFICATION for the RevOps Lab - deliberately NOT inside revops-lab/ and never deployed.
  Create the External Credential, principal and Named Credential in Setup. No secret, token or real URL belongs in
  source control; the URL below is a non-routable placeholder. Unit tests use HttpCalloutMock and need none of this.
-->
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <allowMergeFieldsInBody>false</allowMergeFieldsInBody>
    <allowMergeFieldsInHeader>false</allowMergeFieldsInHeader>
    <generateAuthorizationHeader>true</generateAuthorizationHeader>
    <label>Sales ERP</label>
    <namedCredentialParameters>
        <parameterName>Url</parameterName>
        <parameterType>Url</parameterType>
        <parameterValue>https://atlas-erp.example.invalid</parameterValue>
    </namedCredentialParameters>
    <namedCredentialParameters>
        <externalCredential>Sales_ERP_Ext</externalCredential>
        <parameterName>ExternalCredential</parameterName>
        <parameterType>Authentication</parameterType>
    </namedCredentialParameters>
    <namedCredentialType>SecuredEndpoint</namedCredentialType>
</NamedCredential>
